      "image_size": [1000, 750],
      "fx": 500,
      "fy": 500,
      "cx": 500,
      "cy": 375
    },
    "turned_right": {
      "yaw_deg": 90,
      "pitch_deg": 0,
      "position": [0, 0, 0],
      "image_size": [1000, 750],
      "fx": 500,
      "fy": 500,
      "cx": 500,
      "cy": 375
    },
