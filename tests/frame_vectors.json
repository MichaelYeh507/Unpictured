      "points": [
        { "label": "source camera", "raw": [0, 0, 0], "game": [0, 1.6, 0] },
        { "label": "floor below the camera", "raw": [0, 0.8, 0], "game": [0, 0, 0] },
        { "label": "one raw unit ahead", "raw": [0, 0, 1], "game": [0, 1.6, -2] },
        { "label": "right, above and behind", "raw": [1, -0.5, -2], "game": [2, 2.6, 4] }
      ]
    },
    {
